stages:                         # Pipeline ke stages define karo
  - build                       # Pehla stage: build
  - deploy                      # Doosra stage: deploy

build:                          # Job ka naam
  stage: build                  # Ye job build stage ka hissa hai
  image: maven:3.8.1-jdk-17    # Job ke liye Maven + Java 17 image
  script:                       # Job mein chalne wale commands
    - git clone https://github.com/Pathnex/sample-java-app.git
                                  # GitHub repository clone karo
    - cd sample-java-app          # Project directory mein jao
    - mvn clean compile           # Maven se code compile karo

  only:                         # Job kab run hoga, uska legacy rule
    - main                      # Sirf main branch par run karo

deploy:                         # Deploy job ka naam
  stage: deploy                 # Ye deploy stage mein chalega
  image: alpine:latest          # Lightweight Alpine Linux image use karo
  script:
    - echo "Deploying to $CI_ENVIRONMENT_NAME by Pathnex"
    # Environment name ke saath message print karo

  only:                         # Job ke execution rules
    variables:                  # Variable ki value check karo
      - $CI_ENVIRONMENT_NAME == "dev"
      # Variable dev ho tab job run karne ka rule
