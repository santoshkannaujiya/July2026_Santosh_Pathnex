# Jenkins Pipeline — Conditional Execution

pipeline {  // Declarative ka naam 
   agent any   // available jenkins agent par run karo 
   parameters{  //user-input parameters
         string(
            name: 'Environment'  //Parameter ka purpose

         )
    }
    environmnet {         // pipeline environment variable
         INSTITUTE_NAME = "PATHNEX   // variable mein institute ka naam "}

         stages {        //pipeline ke stages yahan define hote hain 
         stage('checkout') {   // source code checkout stage
            steps {             // satges mein execute hone wala steps
                 git branch: 'mein',
                     url: https://github.com/Pathnex/sample-java-app.git'    // github se main branch ka code checkout karo 
                     }
            }
         stage ('Build') {       // build stage
              when {             // stages run karne ki condition 
              branch 'main'      // main branch par hi run karne ka rule}
              steps{
                sh 'mvn clean compile'  // maven se clean karke java code compile karo

              }
        }
         stage ('deploy') {         // deploy stage
             when {                  // deployment ki condition 
                 expression { 
                    params.ENVIRONMENT == 'dev'    // parameter dev ho tabhi stage run karo 
                 }
                 
            }
                steps {
                    sh 'echo "deployment to $ENVIRONMENT by $INSTITUTE_NAME"'       //shell mein deployment msg print karo 
                                            // ye command actual deployment nhi krti

                
                }
            }
        }
    }







